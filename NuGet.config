<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repo only uses public packages (Discord.Net, EF Core, TagLibSharp, xunit).
    `clear` drops any machine/user level feeds so a restore here does not depend on
    a corporate mirror being reachable.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
