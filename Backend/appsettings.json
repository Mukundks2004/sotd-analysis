{
  // The frontend dev server proxies /api and /files here, so the port must not depend on which
  // launch profile (or none at all) started the app.
  "Urls": "http://localhost:5280",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "sotd.db"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  }
}
